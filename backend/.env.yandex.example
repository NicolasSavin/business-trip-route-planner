# Runtime settings for a Yandex Serverless Container revision.
APP_ENV=development
PORT=8080

# RZD HTTP availability and debug probe.
RZD_AVAILABILITY_ENABLED=true
RZD_AVAILABILITY_TIMEOUT_SECONDS=20
RZD_AVAILABILITY_RETRIES=0
RZD_STATION_LOOKUP_TIMEOUT_SECONDS=8
RZD_TICKET_SEARCH_TIMEOUT_SECONDS=15
RZD_HTTP_PROBE_VERIFY_SSL=false

# Keep both Tutu integrations disabled: this image does not install Chromium.
TUTU_ENABLED=false
TUTU_PLAYWRIGHT_ENABLED=false

# Optional existing backend integrations. Add secret values in the revision UI.
YANDEX_RASP_ENABLED=false
YANDEX_RASP_API_KEY=
FRONTEND_HOSTNAME=
